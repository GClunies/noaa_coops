{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "noaa-coops",
      "release-as": "1.0.0",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        }
      ],
      "extra-files": [
        {
          "type": "yaml",
          "path": "CITATION.cff",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
